				{
					"name": "Get All Payments",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"Response is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));",
									"const payments = pm.response.json();",
									"const currentId = Number(pm.environment.get(\"paymentId\"));",
									"const payment = payments.find(p => p.id === currentId) || payments[0];",
									"pm.test(\"Payment status is Success\", () => pm.expect(payment.status).to.eql(\"Success\"));"
								],
